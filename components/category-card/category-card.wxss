.category-card {
  min-height: 236rpx;
  box-sizing: border-box;
  padding: 24rpx;
  border: 1rpx solid rgba(91, 122, 168, 0.12);
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 12rpx 34rpx rgba(38, 91, 145, 0.07);
}

.category-card:active {
  opacity: 0.78;
  transform: scale(0.98);
}

.pill {
  display: inline-flex;
  align-items: center;
  min-height: 42rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(52, 120, 255, 0.1);
  color: #2f62db;
  font-size: 22rpx;
  font-weight: 600;
}

.category-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.category-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 60rpx;
  border-radius: 20rpx;
  background: #eef6ff;
  font-size: 32rpx;
}

.category-name {
  margin-top: 22rpx;
  color: #172033;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1.35;
}

.category-desc {
  height: 72rpx;
  margin-top: 10rpx;
  color: #6c7d94;
  font-size: 23rpx;
  line-height: 1.55;
  overflow: hidden;
}

.category-meta {
  margin-top: 14rpx;
  color: #2f62db;
  font-size: 23rpx;
  font-weight: 700;
}
