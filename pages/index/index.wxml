<view class="page index-page">
  <view class="hero soft-panel">
    <view class="hero-kicker">AI Knowledge Quiz</view>
    <view class="hero-title">今天学一点 AI 小知识</view>
    <view class="hero-subtitle">用 3 分钟提升你的 AI 理解力</view>
  </view>

  <view class="daily-card card">
    <view>
      <view class="daily-label">今日推荐</view>
      <view class="daily-title">今日 AI 快问快答</view>
      <view class="daily-meta">{{dailyStatus}}</view>
    </view>
    <view class="primary-button daily-button tap-card" bindtap="startDailyQuiz">{{dailyButtonText}}</view>
  </view>

  <view class="section">
    <view class="section-head">
      <view class="section-title">知识分类</view>
      <view class="section-more" bindtap="goCategories">全部分类</view>
    </view>
    <view class="category-grid">
      <category-card
        wx:for="{{categories}}"
        wx:key="id"
        item="{{item}}"
        bind:select="handleCategorySelect"
      />
    </view>
  </view>

  <view class="section">
    <view class="section-head">
      <view class="section-title">学习数据</view>
    </view>
    <view class="stats-grid">
      <stat-card wx:for="{{stats}}" wx:key="label" label="{{item.label}}" value="{{item.value}}" />
    </view>
  </view>

  <view class="section">
    <view class="section-head">
      <view class="section-title">快捷入口</view>
    </view>
    <view class="quick-list card">
      <view class="quick-item tap-card" bindtap="goWrongbook">
        <view>
          <view class="quick-title">错题本</view>
          <view class="quick-desc">复习答错的知识点</view>
        </view>
        <view class="quick-arrow">›</view>
      </view>
      <view class="quick-item tap-card" bindtap="goProfile">
        <view>
          <view class="quick-title">我的收藏</view>
          <view class="quick-desc">查看收藏的题目解析</view>
        </view>
        <view class="quick-arrow">›</view>
      </view>
      <view class="quick-item tap-card" bindtap="goProfile">
        <view>
          <view class="quick-title">学习记录</view>
          <view class="quick-desc">回顾每次答题表现</view>
        </view>
        <view class="quick-arrow">›</view>
      </view>
    </view>
  </view>
</view>
