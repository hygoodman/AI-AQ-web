.hero {
  padding: 42rpx 34rpx;
  border: 1rpx solid rgba(91, 122, 168, 0.12);
}

.hero-kicker {
  color: #3971ff;
  font-size: 23rpx;
  font-weight: 800;
  letter-spacing: 0;
}

.hero-title {
  margin-top: 18rpx;
  color: #111b2f;
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1.2;
}

.hero-subtitle {
  margin-top: 14rpx;
  color: #52677f;
  font-size: 28rpx;
  line-height: 1.55;
}

.daily-card {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  margin-top: 28rpx;
  padding: 32rpx;
}

.daily-label {
  color: #23a6a8;
  font-size: 24rpx;
  font-weight: 800;
}

.daily-title {
  margin-top: 10rpx;
  color: #172033;
  font-size: 38rpx;
  font-weight: 800;
}

.daily-meta {
  margin-top: 10rpx;
  color: #6c7d94;
  font-size: 26rpx;
}

.daily-button {
  width: 100%;
}

.category-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 14rpx;
  padding: 18rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, rgba(232, 247, 255, 0.9), rgba(247, 242, 255, 0.9));
}

.quick-list {
  overflow: hidden;
}

.quick-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 28rpx;
  border-bottom: 1rpx solid rgba(91, 122, 168, 0.1);
}

.quick-item:last-child {
  border-bottom: 0;
}

.quick-title {
  color: #172033;
  font-size: 29rpx;
  font-weight: 700;
}

.quick-desc {
  margin-top: 8rpx;
  color: #6c7d94;
  font-size: 24rpx;
}

.quick-arrow {
  color: #9aa9bd;
  font-size: 48rpx;
  line-height: 1;
}
