.profile-head {
  padding: 38rpx 32rpx;
  border: 1rpx solid rgba(91, 122, 168, 0.12);
}

.profile-title {
  margin-bottom: 12rpx;
  color: #172033;
  font-size: 42rpx;
  font-weight: 800;
}

.record-list,
.favorite-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.record-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx;
}

.record-date {
  color: #172033;
  font-size: 28rpx;
  font-weight: 800;
}

.record-accuracy {
  color: #2f62db;
  font-size: 34rpx;
  font-weight: 900;
}

.favorite-card {
  padding: 28rpx;
}

.favorite-category {
  color: #2f62db;
  font-size: 24rpx;
  font-weight: 800;
}

.favorite-question {
  margin-top: 12rpx;
  color: #172033;
  font-size: 29rpx;
  font-weight: 800;
  line-height: 1.45;
}

.favorite-answer {
  margin-top: 14rpx;
  color: #159257;
  font-size: 25rpx;
  font-weight: 800;
}

.favorite-text {
  margin-top: 10rpx;
  color: #52677f;
  font-size: 25rpx;
  line-height: 1.65;
}

.favorite-remove {
  margin-top: 22rpx;
}
