@import './styles/theme.wxss';

page {
  min-height: 100vh;
  background: linear-gradient(180deg, #f3f8ff 0%, #f8fbff 48%, #ffffff 100%);
  color: #172033;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Arial, sans-serif;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx 28rpx 48rpx;
}

.section {
  margin-top: 32rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.section-title {
  color: #172033;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.3;
}

.section-more {
  color: #58708f;
  font-size: 25rpx;
}

.card {
  box-sizing: border-box;
  border: 1rpx solid rgba(91, 122, 168, 0.12);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.88);
  box-shadow: 0 18rpx 46rpx rgba(38, 91, 145, 0.08);
}

.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #3478ff 0%, #7c5cff 100%);
  color: #ffffff;
  font-size: 29rpx;
  font-weight: 700;
  box-shadow: 0 14rpx 28rpx rgba(75, 112, 255, 0.22);
}

.ghost-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 82rpx;
  border-radius: 22rpx;
  background: #eef5ff;
  color: #2f62db;
  font-size: 28rpx;
  font-weight: 700;
}

.muted-text {
  color: #6c7d94;
  font-size: 26rpx;
  line-height: 1.65;
}
